```
# Laravel-specific ignores
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/app/*
!storage/app/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/*
!storage/framework/.gitignore
storage/logs/*
!storage/logs/.gitignore

# Dependencies
vendor/
node_modules/

# Environment specific files
.env
.env.local
.env.*
!.env.example

# Build and cache directories
public/build/
public/storage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
.phpunit.result.cache
```