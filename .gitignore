```
# PowerShell execution policy cache
Microsoft.PowerShell.Core/

# Windows-specific
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*~
.DS_Store

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Dependencies (if any PowerShell modules are installed)
Modules/
node_modules/
vendor/

# Build/output directories
dist/
build/
output/
target/

# Python artifacts (in case Python scripts are used alongside PowerShell)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Compressed archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
```